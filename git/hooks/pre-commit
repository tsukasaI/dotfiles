#!/usr/bin/env bash
# Global pre-commit hook: block accidental secret commits across all repos.
# Active via core.hooksPath (~/.config/git/hooks). Bypass: git commit --no-verify.
#
# Note: repos that set their own core.hooksPath (e.g. husky) override this and
# will NOT run it — this is a personal baseline, not a guarantee for every repo.

set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  if [ "${SKIP_GITLEAKS:-}" = "1" ]; then
    printf '\033[33mgitleaks not found — SKIP_GITLEAKS=1 set, allowing commit.\033[0m\n' >&2
    exit 0
  fi
  printf '\033[31mgitleaks not found on PATH — commit blocked (fail-closed).\033[0m\n' >&2
  printf 'Install gitleaks, or set SKIP_GITLEAKS=1 to bypass.\n' >&2
  exit 1
fi

if ! gitleaks git --staged --no-banner --redact --verbose; then
  printf '\033[31m\ngitleaks: potential secret in staged changes — commit aborted.\033[0m\n' >&2
  printf 'Review the finding above. To bypass intentionally: git commit --no-verify\n' >&2
  exit 1
fi
