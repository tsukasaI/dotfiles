#!/usr/bin/env bash
# Global prepare-commit-msg hook: no global checks — delegates to the repo's
# own lefthook hooks (see lefthook-chain.sh). Exists so per-repo lefthook works
# while a global core.hooksPath is active (git ignores .git/hooks entirely then).
# Locked with `chflags uchg` — to edit: chflags nouchg ~/dotfiles/git/hooks/*

set -euo pipefail

. "$(cd "$(dirname "$0")" && pwd)/lefthook-chain.sh"
run_repo_lefthook prepare-commit-msg "$@"
