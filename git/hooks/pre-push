#!/usr/bin/env bash
# Global pre-push hook: no global checks — delegates to the repo's own lefthook
# hooks (see lefthook-chain.sh). Exists so per-repo lefthook works while a
# global core.hooksPath is active (git ignores .git/hooks entirely then).
# Locked with `chflags uchg` — to edit: chflags nouchg ~/dotfiles/git/hooks/*
#
# Note: jobs that read the pushed-refs list from stdin need `use_stdin: true`
# in that repo's lefthook.yml (lefthook's own PTY behavior, unrelated to us).

set -euo pipefail

. "$(cd "$(dirname "$0")" && pwd)/lefthook-chain.sh"
run_repo_lefthook pre-push "$@"
