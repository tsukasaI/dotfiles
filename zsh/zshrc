if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  . '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi

_cached_eval() {
  local name=$1 cmd=$2
  local cache_dir="$HOME/.cache/zsh"
  local cache="$cache_dir/$name.zsh"
  local src="$cache_dir/$name.src"
  local bin=$(command -v ${cmd%% *} 2>/dev/null)
  if [[ -z "$bin" ]]; then
    rm -f "$cache" "$src" # tool gone: drop stale cache, don't source it
    return
  fi
  # Not `-nt` alone: Nix binaries all carry the 1970 epoch mtime, so only the
  # resolved store path changes on a Nix upgrade.
  local resolved=${bin:A}
  if [[ ! -f "$cache" || "$bin" -nt "$cache" || "$(cat "$src" 2>/dev/null)" != "$resolved" ]]; then
    mkdir -p "$cache_dir"
    # Record $resolved only on success, so a failed regeneration is retried
    # next shell instead of pinning the stale cache.
    if eval "$cmd" > "$cache.tmp"; then
      mv -f "$cache.tmp" "$cache"
      print -r -- "$resolved" > "$src"
    else
      rm -f "$cache.tmp"
    fi
  fi
  [[ -f "$cache" ]] && source "$cache"
}

_cached_eval mise-activate "mise activate zsh"

[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# Not left to each repo: a repo's own .gitleaks.toml would otherwise configure
# gitleaks runs inside its scripts (lefthook already passes --config).
export GITLEAKS_CONFIG="$HOME/.config/gitleaks/gitleaks.toml"

(( $+commands[gpgconf] )) && { gpgconf --launch keyboxd; gpgconf --launch gpg-agent; } >/dev/null 2>&1 &!

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt HIST_REDUCE_BLANKS

zmodload zsh/datetime
autoload -Uz vcs_info
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' unstagedstr '*'
zstyle ':vcs_info:*' stagedstr '+'
zstyle ':vcs_info:git:*' formats $' %%F{cyan}%b%u%c%%f'
zstyle ':vcs_info:git:*' actionformats $' %%F{cyan}%b%u%c%%f %%F{red}(%a)%%f'

_cmd_timer_preexec() { _cmd_start=$EPOCHREALTIME }
_cmd_timer_precmd() {
  if [[ -n "$_cmd_start" ]]; then
    local elapsed=$(( EPOCHREALTIME - _cmd_start ))
    unset _cmd_start
    if (( elapsed >= 3 && elapsed < 600 )); then
      local s=$(( ${elapsed%.*} ))
      if (( s >= 60 )); then
        _cmd_duration=" %F{yellow}$((s/60))m$((s%60))s%f"
      else
        _cmd_duration=" %F{yellow}${s}s%f"
      fi
      return
    fi
  fi
  _cmd_duration=""
}

_cloud_info() {
  _cloud_prompt=""
  if [[ -n "$AWS_PROFILE" ]]; then
    _cloud_prompt+=$' %F{yellow}'"$AWS_PROFILE"
    [[ -n "$AWS_REGION" ]] && _cloud_prompt+="($AWS_REGION)"
    _cloud_prompt+="%f"
  fi
  if [[ -n "$CLOUDSDK_ACTIVE_CONFIG_NAME" || -n "$GOOGLE_CLOUD_PROJECT" ]]; then
    local gcp="${GOOGLE_CLOUD_PROJECT:-$CLOUDSDK_ACTIVE_CONFIG_NAME}"
    _cloud_prompt+=$' %F{blue}'"$gcp%f"
  fi
}
precmd() { vcs_info; _cmd_timer_precmd; _cloud_info }
preexec() { _cmd_timer_preexec "$@" }
setopt PROMPT_SUBST
PROMPT='%F{blue}%2~%f${vcs_info_msg_0_}${_cloud_prompt}${_cmd_duration} %(?.%F{green}.%F{yellow})❯%f '

if [[ $- == *i* ]]; then
  alias ls='eza --icons --color=always'
  alias find='fd'
  alias ps='procs'

  _cached_eval zoxide "zoxide init zsh"
  alias cd='z'

  _cached_eval fzf "fzf --zsh"
fi

autoload -Uz add-zsh-hook
_osc7_cwd() {
  print -Pn "\e]7;file://localhost${PWD}\e\\"
}
add-zsh-hook precmd _osc7_cwd
