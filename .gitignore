# Nix
result
result-*

# MacOS
.DS_Store

# Karabiner
karabiner/automatic_backups/

# Claude Code: override user-global .claude/ ignore so project-scoped config (skills, etc.) is trackable,
# while keeping session-local state ignored.
!.claude/
.claude/memory/
.claude/plans/
.claude/worktrees/
.claude/settings.local.json

# Claude Code's local cache of claude.ai account skills, written through the
# ~/.claude/skills symlink; machine-generated and includes personal custom skills.
claude-code/skills/synced/
