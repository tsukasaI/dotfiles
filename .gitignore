.DS_Store

karabiner/automatic_backups/

# Overrides the user-global .claude/ ignore, keeping session-local state ignored.
!.claude/
.claude/memory/
.claude/plans/
.claude/worktrees/
.claude/settings.local.json

# Claude Code's local cache of claude.ai account skills, written through the
# ~/.claude/skills symlink; machine-generated and includes personal custom skills.
claude-code/skills/synced/

# API declarations Claude Code writes beside a loaded plugin on every load.
claude-code/mod/.claude-plugin/types/

# Links into ~/engineer/coding-guidelines, created by setup.sh; that repo is
# the source, not this one.
claude-code/rules/coding-guidelines/
