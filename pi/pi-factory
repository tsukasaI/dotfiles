#!/bin/bash
# Runs Pi with the factory-workspace Anthropic API key, exported to this
# process only. Key lives in the macOS Keychain (service "claude-factory").
#   pi-factory [pi args...]            host
#   pi-factory --container [pi args...]   pi-sandbox via apple/container, $PWD at /workspace
#   pi-factory --build                 build pi-sandbox:<host pi version> (no key needed)

set -euo pipefail

readonly DEFAULT_MODEL="claude-sonnet-5-5"
readonly IMAGE="pi-sandbox"

die() { echo "pi-factory: $*" >&2; exit 1; }

host_pi_version() {
  command -v pi >/dev/null || die "pi not found (run darwin-rebuild switch)"
  local v
  v="$(pi --version 2>&1)" || die "pi --version failed"
  # Not echoing v: it is untrusted output and ends up in build args and an image tag.
  [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "unexpected pi --version output"
  echo "$v"
}

if [[ "${1:-}" == "--build" ]]; then
  version="$(host_pi_version)"
  dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
  command -v container >/dev/null || die "container not found (apple/container; run darwin-rebuild switch)"
  exec container build -t "$IMAGE:$version" --build-arg "PI_VERSION=$version" \
    -f "$dir/Dockerfile.pi" "$dir"
fi

if [[ "${1:-}" == "--container" ]]; then
  shift
  command -v container >/dev/null || die "container not found (apple/container; run darwin-rebuild switch)"
  version="$(host_pi_version)"
  # Before the Keychain read: a stale image must fail without touching the key.
  container image inspect "$IMAGE:$version" >/dev/null 2>&1 \
    || die "image $IMAGE:$version not found; run: pi-factory --build"
  mode=container
else
  mode=host
fi

# Not just "env wins": Pi prefers a stored auth.json credential over
# ANTHROPIC_API_KEY, so a stray /login would silently move billing off the
# factory key. Not a bare existence check: Pi recreates an empty {} on every
# start. Unparseable counts as non-empty.
auth_json="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/auth.json"
if [[ -e "$auth_json" ]] && ! jq -e 'type == "object" and length == 0' "$auth_json" >/dev/null 2>&1; then
  die "$auth_json holds a stored credential; remove it (/logout) so the factory key is used"
fi

readonly KEYCHAIN_SERVICE="claude-factory"
key="$(security find-generic-password -a "$USER" -s "$KEYCHAIN_SERVICE" -w 2>/dev/null)" \
  || die "no Keychain item for service $KEYCHAIN_SERVICE (account $USER)"
[[ -n "$key" ]] || die "Keychain item $KEYCHAIN_SERVICE is empty"

unset ANTHROPIC_AUTH_TOKEN ANTHROPIC_OAUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN
export ANTHROPIC_API_KEY="$key"
unset key
export PI_TELEMETRY=0 PI_SKIP_VERSION_CHECK=1

if [[ "$mode" == container ]]; then
  container volume inspect pi-agent-home >/dev/null 2>&1 \
    || container volume create pi-agent-home >/dev/null
  model_args=(--model "$DEFAULT_MODEL")
  for arg in "$@"; do
    [[ "$arg" == --model || "$arg" == --model=* ]] && model_args=()
  done
  tty_args=()
  [[ -t 0 && -t 1 ]] && tty_args=(-t)
  # Not -e ANTHROPIC_API_KEY=<value>: a value in argv shows up in `ps`.
  # ${a[@]+...}: /bin/bash 3.2 treats an empty array as unbound under set -u.
  exec container run --rm -i ${tty_args[@]+"${tty_args[@]}"} \
    -e ANTHROPIC_API_KEY -e PI_TELEMETRY -e PI_SKIP_VERSION_CHECK \
    -v "$PWD:/workspace" \
    -v pi-agent-home:/root/.pi/agent \
    "$IMAGE:$version" ${model_args[@]+"${model_args[@]}"} "$@"
fi

command -v pi >/dev/null || die "pi not found (run darwin-rebuild switch)"
exec pi "$@"
