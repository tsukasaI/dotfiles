  ],
  "edges": [
    { "id": "e-client-api", "from": "client", "to": "api", "data": "短縮要求 / 短縮URLへのアクセス" },
    { "id": "e-api-db", "from": "api", "to": "db", "data": "コードと URL の読み書き" },
    { "id": "e-api-cache", "from": "api", "to": "cache", "kind": "proposed", "data": "コードで先に引く" },
    { "id": "e-api-idgen", "from": "api", "to": "idgen", "kind": "proposed", "data": "新しい ID を採番" },
    { "id": "e-api-queue", "from": "api", "to": "queue", "kind": "proposed", "data": "クリックを記録" },
    { "id": "e-queue-stats", "from": "queue", "to": "stats", "kind": "proposed", "data": "非同期で集計" }
  ],
  "steps": [
    {
      "title": "読み取りをキャッシュで受ける",
      "description": "リダイレクトは書き込みよりずっと多く、人気のコードにアクセスが偏る。API はまずキャッシュを引き、外れたときだけ DB を読む。",
      "changes": { "cache": "added", "e-api-cache": "added", "e-api-db": "changed" }
    },
    {
      "title": "ID を採番器で作る",
      "description": "乱数でコードを作ると衝突確認のための DB 往復が要る。連番を base62 にすれば、確認なしで一意で短いコードが得られる。",
      "changes": { "idgen": "added", "e-api-idgen": "added" }
    },
    {
      "title": "クリック集計を非同期にする",
      "description": "リダイレクトの応答内で集計を書くと遅くなる。イベントをキューに積み、別の処理が集計ストアへ書く。",
      "changes": { "queue": "added", "stats": "added", "e-api-queue": "added", "e-queue-stats": "added" }
