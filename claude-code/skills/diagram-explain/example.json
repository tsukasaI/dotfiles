    { "id": "data", "label": "データ層" }
  ],
  "nodes": [
    { "id": "client", "lane": "client", "order": 0, "label": "ブラウザ" },
    { "id": "api", "lane": "app", "order": 0, "label": "API サーバー: 短縮とリダイレクト" },
    { "id": "db", "lane": "data", "order": 0, "label": "DB: 短縮コード → 元 URL" },
    { "id": "cache", "lane": "data", "order": 1, "kind": "proposed", "label": "キャッシュ（Redis など）" },
    { "id": "idgen", "lane": "app", "order": 1, "kind": "proposed", "label": "ID 生成器: 連番 → base62" },
    { "id": "queue", "lane": "app", "order": 2, "kind": "proposed", "label": "クリックイベントのキュー" },
