{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "EDITOR": "nvim",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(eza:*)",
      "Bash(tokei:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git tag:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go get:*)",
      "Bash(go mod tidy:*)",
      "Bash(golangci-lint run:*)",
      "Bash(wait)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(gh repo view:*)",
      "Bash(gh search:*)",
      "Bash(gh issue:*)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:neovim.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:cloud.google.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:firebase.google.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:aws.amazon.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:blog.cloudflare.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:azure.microsoft.com)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:support.claude.com)",
      "Bash(defaults read *)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:arxiv.org)",
      "mcp__cc-memory__get_last_retro",
      "mcp__cc-memory__list_facts",
      "mcp__cc-memory__process_inbox",
      "mcp__cc-memory__edit_fact",
      "mcp__cc-memory__delete_fact",
      "mcp__cc-memory__upsert_learnings",
      "mcp__cc-memory__upsert_summary",
      "mcp__cc-memory__update_hot_facts",
      "mcp__cc-memory__record_retro_run",
      "mcp__claude_ai_staygreen__*"
    ],
    "deny": [
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/.env*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/node_modules/**)",
      "Read(**/.wrangler/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/venv/**)",
      "Read(**/.venv/**)",
      "Read(**/target/**)",
      "Read(**/.next/**)",
      "Read(**/.turbo/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.pytest_cache/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-6[1M]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "fini \"$(jq -r '.tool_input.file_path')\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude-code/hooks/mark-session-edit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude-code/hooks/block-dangerous.sh"
          },
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude-code/hooks/shguard-shadow.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude-code/hooks/block-config-edit.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun $HOME/dotfiles/claude-code/hooks/save-transcript.ts",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/claude-code/hooks/warn-uncommitted.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bun $HOME/dotfiles/claude-code/statusline.ts"
  },
  "viewMode": "verbose",
  "advisorModel": "fable",
  "askUserQuestionTimeout": "never",
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:dark-ansi-readable",
  "preferredNotifChannel": "ghostty",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "copyOnSelect": false,
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skillOverrides": {
    "actions-pin-audit": "off",
    "article": "off",
    "failure-archaeology": "off",
    "weekly-digest": "off"
  }
}
