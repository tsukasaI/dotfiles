{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "opus",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoMemoryEnabled": false,
  "copyOnSelect": false,
  "effort": "high",
  "enabledPlugins": {
    "goal-setter@goal-setter": true
  },
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "EDITOR": "nvim",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "extraKnownMarketplaces": {
    "goal-setter": {
      "source": {
        "repo": "gotalab/goal-setter-skill",
        "source": "github"
      }
    },
    "supabase-agent-skills": {
      "source": {
        "repo": "supabase/agent-skills",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "fini \"$(jq -r '.tool_input.file_path')\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/dotfiles/claude-code/hooks/block-dangerous.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "$HOME/dotfiles/claude-code/hooks/block-config-edit.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "bun $HOME/dotfiles/claude-code/hooks/save-transcript.ts",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/inouetsukasa/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "claude-opus-4-6[1M]",
  "permissions": {
    "allow": [
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(eza:*)",
      "Bash(tokei:*)",
      "Bash(docker run:*)",
      "Bash(docker build:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git tag:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go get:*)",
      "Bash(go mod tidy:*)",
      "Bash(golangci-lint run:*)",
      "Bash(wait)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(gh repo view:*)",
      "Bash(gh search:*)",
      "Bash(gh issue:*)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:gist.github.com)",
      "Bash(gh api:*)",
      "WebFetch(domain:neovim.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:cloud.google.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:firebase.google.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:aws.amazon.com)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:blog.cloudflare.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:azure.microsoft.com)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:support.claude.com)",
      "Bash(defaults read *)"
    ],
    "defaultMode": "default",
    "deny": [
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/.env*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/node_modules/**)",
      "Read(**/.wrangler/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/venv/**)",
      "Read(**/.venv/**)",
      "Read(**/target/**)",
      "Read(**/.next/**)",
      "Read(**/.turbo/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.pytest_cache/**)"
    ],
    "disableAutoMode": "disable"
  },
  "plansDirectory": ".claude/plans",
  "preferredNotifChannel": "ghostty",
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bun $HOME/dotfiles/claude-code/statusline.ts",
    "type": "command"
  },
  "theme": "custom:dark-ansi-readable",
  "tui": "fullscreen",
  "useAutoModeDuringPlan": false,
  "viewMode": "verbose"
}
